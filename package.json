{
  "name": "omni-mcp",
  "version": "0.1.0",
  "description": "Local-first OpenAPI to MCP gateway. Bring your own credentials; no hosted control plane.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "omni-mcp": "src/cli.js"
  },
  "files": [
    "src",
    "presets.json",
    "README.md",
    "LICENSE",
    "docs",
    "omni.config.default.json",
    "omni.config.example.json",
    "local-servers.json",
    "catalog",
    "scripts/generate-batch.js",
    "scripts/catalog-report.js",
    "scripts/verify-public.js",
    "generated/report.json",
    "SECURITY.md",
    "omni.local.example.json"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/cli.js && node --check src/compiler.js && node --check src/engine.js",
    "generate": "node scripts/generate-batch.js",
    "start": "node src/cli.js serve --config omni.config.json",
    "catalog": "node src/cli.js catalog-sync",
    "catalog:report": "node scripts/catalog-report.js",
    "verify:public": "node scripts/verify-public.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "ipaddr.js": "2.3.0",
    "swagger2openapi": "7.0.8",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/segz7448/omni-mcp.git"
  },
  "homepage": "https://github.com/segz7448/omni-mcp",
  "bugs": {
    "url": "https://github.com/segz7448/omni-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
